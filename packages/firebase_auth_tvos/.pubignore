# A .pubignore replaces this directory's .gitignore for `dart pub publish`, so
# the .gitignore rules are repeated below.
#
# pubspec_overrides.yaml (here and in example/) points firebase_core_tvos at the
# sibling package until firebase_core_tvos 0.0.4 is on pub.dev. It is for the
# repo's CI only and must not ship.
pubspec_overrides.yaml

# Dart / Flutter
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub/

# CocoaPods
tvos/Pods/
tvos/Podfile.lock
tvos/.symlinks/
tvos/Flutter/Flutter.framework
tvos/Flutter/Flutter.podspec

# Xcode / SwiftPM (per-user, generated when tvos/Package.swift is opened)
**/.swiftpm/
**/xcuserdata/

# IDE
.idea/
.vscode/
*.iml

# macOS
.DS_Store
